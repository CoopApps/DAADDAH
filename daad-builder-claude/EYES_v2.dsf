/PRO 0

; PRO 0 is the first process executed in DAAD.
; Calls init if at location 0, then runs main loop.

>
_       _       AT 0
                PROCESS 6

; Sets DarkF according to Dark flag and light sources.
>
_       _       CLEAR DarkF
                NOTZERO Dark
                ABSENT 0
                SET DarkF

; Updates status line.
>
_       _       PROCESS 11

; Set text window position (with platform-specific split screen).
>
_       _       WINAT 13 0
                #ifdef "splitModeOn"
                    XSPLITSCR 1
                    #ifdef "cpc"
                    WINAT 14 0
                    #endif
                #endif
                WINDOW 1
                WINSIZE 25 127

; If dark, print darkness message.
>
_       _       NOTZERO DarkF
                SYSMESS 0

; If light, print current location description.
>
_       _       ZERO DarkF
                DESC @Player


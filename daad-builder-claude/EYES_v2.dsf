; EXAMINE catch-all: WHATO resolves noun to object, SYSMESS 63 prints default
>
L       _       WHATO
                SYSMESS 63
                DONE

>
GET     ALL     DOALL HERE
>
GET     _       AUTOG
                DONE

>
DROP    ALL     DOALL CARRIED
>
DROP    _       AUTOD
                DONE

>
REMOVE  ALL     DOALL WORN
>
REMOVE  _       AUTOR
                DONE

>
WEAR    ALL     DOALL CARRIED
>
WEAR    _       AUTOW
                DONE

>
R       _       EQ 34 255
                RESTART

>
R       _       LET 33 30
                REDO

>
QUIT    _       QUIT
                END

>
QUIT    _       DONE

>
SAVE    _       SAVE 0
                RESTART

>
LOAD    _       LOAD 0
                RESTART

>
RAMSA   _       RAMSAVE
                RESTART

>
RAMLO   _       RAMLOAD 255
                RESTART

>
L       _       RESTART

/PRO 6

; Initialization process. Called from PRO 0 at location 0.

>
_       _       WINDOW 2
                WINAT 6 0
                WINSIZE 1 COLS

>
_       _       LT GFlags 128
                WINSIZE 1 80

>
_       _       PAPER 0
                INK 1
                CLS
                PROCESS 9

>
_       _       DESC 0
                ANYKEY
                CLS
                MESSAGE 14
                ANYKEY
                CLEAR 255

>
_       _       NOTEQ 255 GFlags
                CLEAR @255

>
_       _       PLUS 255 1
                LT 255 255
                SKIP -2

>
_       _       RESET
                LET Strength 10
                LET MaxCarr 10
                SET CPNoun
                SET CPAdject
                LET OFlags 64
                GOTO 1

/PRO 7

>
_       _       WINDOW 1
                WINAT 7 0
                WINSIZE ROWS 127
                CLS

/PRO 8

>
_       _       WINDOW 1
                WINAT 7 0
                WINSIZE ROWS 127
                CLS

/PRO 9

>
_       _       PROCESS 8
                DONE

>
_       _       PROCESS 7

/PRO 10

; Automatic exits listing. Uses flags 100 and 101.

>
_       _       MES 0
                CLEAR 101
                LET 33 2

>
_       _       COPYFF 38 100
                MOVE 100
                MES @33
                PLUS 101 1

>
_       _       PLUS 33 1
                LT 33 14
                SKIP -2

>
_       _       NOTZERO 101
                NEWLINE
                DONE

>
_       _       MESSAGE 1

/PRO 11

; Update status line.

>
_       _       WINDOW 2
                PAPER 0
                INK 1
                CLS

; If dark, print darkness label and turns.
>
_       _       NOTZERO DarkF
                MES 33
                PROCESS 12
                DONE

; Print location name for each location.
>
_       _       AT 1
                MES 16

>
_       _       AT 2
                MES 17

>
_       _       AT 3
                MES 18

>
_       _       AT 4
                MES 19

>
_       _       AT 5
                MES 20

>
_       _       AT 6
                MES 21

>
_       _       AT 7
                MES 22

>
_       _       AT 8
                MES 23

>
_       _       AT 9
                MES 24

>
_       _       AT 10
                MES 25

>
_       _       AT 11
                MES 26

>
_       _       AT 12
                MES 27

>
_       _       AT 13
                MES 28

>
_       _       AT 14
                MES 29

>
_       _       AT 15
                MES 30

>
_       _       AT 16
                MES 31

>
_       _       PROCESS 12

/PRO 12

; Print turns at status line.

>
_       _       TAB Turns_TAB
                LT 29 128
                TAB 67

>
_       _       MES 15
                DPRINT Turns
                WINDOW 1

/END
